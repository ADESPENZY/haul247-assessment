# Never bake these into the image
.env
.env.*

# Installed locally — rebuilt inside the container
vendor/
node_modules/

# SQLite dev database — MySQL is used in Docker
database/database.sqlite

# Log files (keep directories, discard content)
storage/logs/*.log
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*

# Git and IDE metadata
.git/
.gitignore
.idea/
.vscode/
.cursor/

# Build artifacts
public/build/
public/hot/
public/storage/

# Docs and CI
*.md
*.yaml
*.yml
phpunit.xml
